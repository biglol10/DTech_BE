# Server Configuration
NODE_ENV=development
PORT=3066

# Database Configuration
MYSQL_URL=your-mysql-host
MYSQL_USER=your-mysql-username
MYSQL_PW=your-mysql-password
MYSQL_DB=your-database-name

# JWT Configuration
# IMPORTANT: Generate secure random strings for production!
# You can use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-access-token-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-key-different-from-access
JWT_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d
COOKIE_EXPIRE=7

# AWS S3 Configuration
accessKeyId=your-aws-access-key-id
secretAccessKey=your-aws-secret-access-key
region=ap-northeast-2
BUCKET_BASE=your-s3-bucket-name

# Frontend URLs (for CORS)
FRONTEND_URL=http://localhost:3000
